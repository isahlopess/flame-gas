{
    "version": 2,
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.9.0"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "LOG_CHANNEL": "stderr",
        "LOG_FORMATTER": "Monolog\\Formatter\\JsonFormatter",
        "CACHE_STORE": "database",
        "DB_CONNECTION": "pgsql",
        "DB_HOST": "ep-plain-fog-aivq6cfj-pooler.c-4.us-east-1.aws.neon.tech",
        "DB_PORT": "5432",
        "DB_DATABASE": "neondb",
        "DB_USERNAME": "neondb_owner",
        "DB_PASSWORD": "npg_iy0nVH9KREfY",
        "NEON_ENDPOINT": "ep-plain-fog-aivq6cfj"
    }
}
